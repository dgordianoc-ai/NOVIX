<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NOVIX</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NOVIX.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header class="novix-header">
        <nav class="navbar navbar-expand-lg navbar-dark novix-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand novix-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    NOVIX<span>.</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#novixNavigation"
                        aria-controls="novixNavigation"
                        aria-expanded="false"
                        aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="novixNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Ingresos"
                               asp-action="Index">
                                Ingresos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Gastos"
                               asp-action="Index">
                                Gastos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Analisis">
                                Análisis
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reportes"
                               asp-action="Index">
                                Reportes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacidad">
                                Privacidad
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <main role="main" class="novix-main">
        @RenderBody()
    </main>

    <footer class="novix-footer">
        <div class="container-fluid px-4">
            <span>© 2026 NOVIX</span>
            <span class="footer-separator">/</span>
            <span>Centro financiero</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>