
@model List<NOVIX.Models.MovimientoFinanciero>

@{
    Layout = null;
    ViewData["Title"] = "NOVIX | Gastos";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-GT");
    decimal totalGastos = Model == null ? 0m : Model.Sum(gasto => gasto.Monto);
    int cantidadGastos = Model == null ? 0 : Model.Count;
    decimal promedioGastos = cantidadGastos == 0 ? 0m : totalGastos / cantidadGastos;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#030305" />

    <title>NOVIX | Gastos</title>

    <style>
        :root {
            --bg: #050507;
            --panel: rgba(15, 15, 20, .88);
            --panel-light: rgba(255, 255, 255, .035);
            --white: #f6f6fb;
            --silver: #c9c9d6;
            --muted: #858592;
            --line: rgba(255, 255, 255, .11);
            --danger: #ff8585;
            --font: "Segoe UI", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            min-height: 100%;
            background: var(--bg);
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            color: var(--white);
            background: var(--bg);
            font-family: var(--font);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button,
        a {
            -webkit-tap-highlight-color: transparent;
        }

        /* FONDO ASTRAL */

        .space-background {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
            background:
                radial-gradient(ellipse at 75% 20%, rgba(150, 150, 190, .10), transparent 40%),
                radial-gradient(ellipse at 15% 90%, rgba(190, 190, 220, .06), transparent 40%),
                #050507;
        }

        #starsCanvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        .nebula {
            position: absolute;
            width: 550px;
            height: 550px;
            border-radius: 50%;
            filter: blur(100px);
            background: radial-gradient(circle, rgba(180, 180, 220, .12), transparent 70%);
            animation: nebulaFloat 18s ease-in-out infinite alternate;
        }

        .nebula-one {
            top: -300px;
            right: -100px;
        }

        .nebula-two {
            bottom: -350px;
            left: 15%;
            animation-delay: -8s;
        }

        /* ESTRUCTURA */

        .app-shell {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
        }

        /* BARRA LATERAL */

        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 10;
            width: 245px;
            padding: 28px 19px;
            display: flex;
            flex-direction: column;
            background: rgba(5, 5, 8, .88);
            border-right: 1px solid var(--line);
            backdrop-filter: blur(25px);
        }

        .brand {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 0 12px 30px;
            border-bottom: 1px solid var(--line);
        }

        .brand-name {
            font-size: 27px;
            font-weight: 300;
            letter-spacing: 7px;
        }

        .brand-name span {
            color: #9c9cab;
        }

        .brand-caption {
            color: var(--muted);
            font-size: 8px;
            letter-spacing: 2.4px;
        }

        .nav-label {
            margin: 27px 12px 12px;
            color: #666674;
            font-size: 8px;
            letter-spacing: 2px;
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .nav-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 14px;
            border: 1px solid transparent;
            border-radius: 5px;
            color: #9999a8;
            font-size: 12px;
            transition: .3s ease;
        }

        .nav-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, .035);
            border-color: rgba(255, 255, 255, .08);
            transform: translateX(3px);
        }

        .nav-link.active {
            color: #fff;
            background: linear-gradient(90deg, rgba(255, 255, 255, .10), rgba(255, 255, 255, .015));
            border-color: rgba(255, 255, 255, .13);
            box-shadow: inset 2px 0 #e4e4ee, 0 0 20px rgba(255, 255, 255, .025);
        }

        .nav-icon {
            width: 21px;
            text-align: center;
            color: #bfc0cd;
            font-size: 16px;
        }

        .sidebar-bottom {
            margin-top: auto;
            padding: 17px 12px 0;
            border-top: 1px solid var(--line);
        }

        .system-status {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #aaaab8;
            font-size: 9px;
            letter-spacing: 1px;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            flex-shrink: 0;
            border-radius: 50%;
            background: #e8e8f2;
            box-shadow: 0 0 12px rgba(255, 255, 255, .65);
            animation: statusPulse 2s infinite;
        }

        .system-version {
            margin-top: 9px;
            color: #626270;
            font-size: 8px;
            letter-spacing: 1px;
        }

        /* CONTENIDO */

        .main-content {
            width: calc(100% - 245px);
            min-width: 0;
            margin-left: 245px;
            padding: 30px clamp(20px, 4vw, 55px) 45px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding-bottom: 23px;
            border-bottom: 1px solid var(--line);
        }

        .breadcrumb {
            color: #767684;
            font-size: 10px;
            letter-spacing: 1.5px;
        }

        .breadcrumb span {
            color: #e4e4ee;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .secure-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border: 1px solid var(--line);
            color: #bfc0cd;
            font-size: 9px;
            letter-spacing: 1px;
        }

        .user-avatar {
            width: 35px;
            height: 35px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, .25);
            background: linear-gradient(145deg, #34343e, #111116);
            font-size: 13px;
        }

        /* ENCABEZADO DE PÁGINA */

        .page-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin: 34px 0 28px;
            animation: enterUp .7s ease both;
        }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 13px;
            color: #a5a5b5;
            font-size: 9px;
            letter-spacing: 2.5px;
        }

        .eyebrow-line {
            width: 26px;
            height: 1px;
            background: #dedee8;
            box-shadow: 0 0 10px rgba(255, 255, 255, .35);
        }

        .page-heading h1 {
            font-size: clamp(30px, 3vw, 43px);
            font-weight: 300;
            letter-spacing: -1.5px;
        }

        .page-heading h1 span {
            color: #a7a7b7;
        }

        .page-description {
            max-width: 540px;
            margin-top: 10px;
            color: #8c8c9b;
            font-size: 12px;
            line-height: 1.8;
        }

        .date-display {
            padding: 11px 14px;
            border: 1px solid var(--line);
            background: rgba(255, 255, 255, .025);
            color: #bfc0cd;
            font-size: 10px;
            white-space: nowrap;
        }

        /* TARJETAS DE RESUMEN */

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 17px;
            margin-bottom: 27px;
        }

        .summary-card {
            position: relative;
            min-width: 0;
            overflow: hidden;
            padding: 23px;
            border: 1px solid rgba(255, 255, 255, .10);
            border-radius: 7px;
            background: linear-gradient(145deg, rgba(255, 255, 255, .055), rgba(255, 255, 255, .012));
            backdrop-filter: blur(15px);
            animation: enterUp .7s ease both;
            transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
        }

        .summary-card:nth-child(2) {
            animation-delay: .1s;
        }

        .summary-card:nth-child(3) {
            animation-delay: .2s;
        }

        .summary-card:hover {
            transform: translateY(-4px);
            border-color: rgba(255, 255, 255, .25);
            box-shadow: 0 15px 40px rgba(0, 0, 0, .25), 0 0 22px rgba(255, 255, 255, .035);
        }

        .summary-card::after {
            content: "";
            position: absolute;
            top: -80px;
            right: -65px;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(210, 210, 235, .06);
            filter: blur(35px);
            pointer-events: none;
        }

        .summary-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .summary-label {
            color: #9999a8;
            font-size: 9px;
            letter-spacing: 1.3px;
        }

        .summary-icon {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, .13);
            border-radius: 7px;
            background: rgba(255, 255, 255, .04);
            color: #e2e2ed;
            font-size: 16px;
        }

        .summary-value {
            margin-top: 22px;
            overflow-wrap: anywhere;
            color: #fff;
            font-size: clamp(20px, 2.2vw, 29px);
            font-weight: 300;
            letter-spacing: -.7px;
        }

        .summary-note {
            margin-top: 9px;
            color: #747482;
            font-size: 10px;
        }

        /* MENSAJES */

        .alert {
            margin-bottom: 18px;
            padding: 13px 16px;
            border: 1px solid rgba(255, 255, 255, .15);
            border-radius: 5px;
            background: rgba(255, 255, 255, .04);
            color: #e7e7ef;
            font-size: 12px;
            line-height: 1.6;
            animation: enterUp .35s ease both;
        }

        .alert.error {
            border-color: rgba(255, 133, 133, .4);
            color: #ffcaca;
            background: rgba(120, 25, 25, .10);
        }

        /* PANELES */

        .content-grid {
            display: grid;
            grid-template-columns: minmax(270px, .78fr) minmax(0, 1.5fr);
            align-items: start;
            gap: 20px;
        }

        .glass-panel {
            min-width: 0;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, .11);
            border-radius: 7px;
            background: linear-gradient(145deg, rgba(17, 17, 23, .91), rgba(8, 8, 12, .91));
            box-shadow: 0 20px 65px rgba(0, 0, 0, .15);
            backdrop-filter: blur(18px);
            animation: enterUp .8s .15s ease both;
        }

        .panel-heading {
            padding: 21px 22px;
            border-bottom: 1px solid var(--line);
        }

        .panel-heading h2 {
            font-size: 14px;
            font-weight: 500;
            letter-spacing: .3px;
        }

        .panel-heading p {
            margin-top: 7px;
            color: #80808f;
            font-size: 10px;
            line-height: 1.7;
        }

        /* FORMULARIO */

        .expense-form {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 19px;
        }

        .form-field {
            display: flex;
            flex-direction: column;
            gap: 9px;
        }

        .form-field label {
            color: #c3c3d0;
            font-size: 9px;
            letter-spacing: 1.3px;
        }

        .field-control {
            width: 100%;
            min-height: 45px;
            padding: 11px 12px;
            border: 1px solid rgba(255, 255, 255, .13);
            border-radius: 4px;
            outline: none;
            background: rgba(0, 0, 0, .24);
            color: #f5f5fa;
            font-size: 12px;
            transition: border-color .3s ease, box-shadow .3s ease, background .3s ease;
            color-scheme: dark;
        }

        .field-control::placeholder {
            color: #696977;
        }

        .field-control:focus {
            border-color: rgba(255, 255, 255, .65);
            background: rgba(255, 255, 255, .035);
            box-shadow: 0 0 17px rgba(255, 255, 255, .07);
        }

        .field-control option {
            background: #111116;
            color: #fff;
        }

        .form-hint {
            color: #777785;
            font-size: 10px;
            line-height: 1.6;
        }

        .primary-button {
            position: relative;
            min-height: 48px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 16px;
            border: 1px solid #fff;
            border-radius: 4px;
            background: linear-gradient(110deg, #f7f7fb, #c9c9d5);
            color: #09090c;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.4px;
            cursor: pointer;
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .primary-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(255, 255, 255, .15);
        }

        .primary-button:focus-visible,
        .delete-button:focus-visible {
            outline: 2px solid #fff;
            outline-offset: 3px;
        }

        .button-shine {
            position: absolute;
            top: -100%;
            left: -60%;
            width: 25%;
            height: 300%;
            transform: rotate(25deg);
            background: rgba(255, 255, 255, .7);
            transition: left .65s ease;
            pointer-events: none;
        }

        .primary-button:hover .button-shine {
            left: 140%;
        }

        /* TABLA */

        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 18px 22px;
            border-bottom: 1px solid var(--line);
        }

        .table-toolbar h2 {
            font-size: 14px;
            font-weight: 500;
        }

        .table-count {
            padding: 7px 10px;
            border: 1px solid var(--line);
            border-radius: 4px;
            color: #c6c6d2;
            font-size: 9px;
            white-space: nowrap;
        }

        .table-scroll {
            width: 100%;
            overflow-x: auto;
        }

        .expense-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .expense-table th {
            padding: 15px 16px;
            border-bottom: 1px solid var(--line);
            background: rgba(255, 255, 255, .018);
            color: #777785;
            font-size: 8px;
            font-weight: 500;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        .expense-table td {
            padding: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, .055);
            color: #d7d7e1;
            font-size: 11px;
            vertical-align: middle;
        }

        .expense-table tbody tr {
            transition: background .25s ease;
            animation: rowAppear .45s ease both;
        }

        .expense-table tbody tr:hover {
            background: rgba(255, 255, 255, .035);
        }

        .expense-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .expense-description {
            max-width: 220px;
            color: #f3f3f8;
            font-weight: 500;
            overflow-wrap: anywhere;
        }

        .category-tag {
            display: inline-block;
            padding: 6px 9px;
            border: 1px solid rgba(255, 255, 255, .13);
            border-radius: 4px;
            background: rgba(255, 255, 255, .035);
            color: #bcbcca;
            font-size: 9px;
        }

        .expense-amount {
            color: #f2c8c8 !important;
            font-weight: 500;
            white-space: nowrap;
        }

        .delete-button {
            padding: 8px 10px;
            border: 1px solid rgba(255, 133, 133, .25);
            border-radius: 4px;
            background: rgba(255, 100, 100, .035);
            color: #ffaaaa;
            font-size: 9px;
            cursor: pointer;
            transition: .25s ease;
        }

        .delete-button:hover {
            border-color: rgba(255, 133, 133, .7);
            background: rgba(255, 100, 100, .12);
            box-shadow: 0 0 15px rgba(255, 100, 100, .06);
        }

        .empty-state {
            padding: 48px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 54px;
            height: 54px;
            margin: 0 auto 17px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, .13);
            border-radius: 50%;
            background: rgba(255, 255, 255, .035);
            color: #d5d5e0;
            font-size: 23px;
            animation: emptyFloat 4s ease-in-out infinite;
        }

        .empty-state h3 {
            font-size: 14px;
            font-weight: 400;
        }

        .empty-state p {
            max-width: 300px;
            margin: 10px auto 0;
            color: #858592;
            font-size: 11px;
            line-height: 1.8;
        }

        .table-footer {
            padding: 15px 22px;
            border-top: 1px solid var(--line);
            color: #737381;
            font-size: 9px;
            line-height: 1.7;
        }

        /* MODAL DE ELIMINACIÓN */

        .confirm-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(2, 4, 5, .78);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        .confirm-overlay.open {
            display: flex;
            animation: overlayIn .22s ease both;
        }

        .confirm-dialog {
            position: relative;
            overflow: hidden;
            width: 100%;
            max-width: 440px;
            padding: 34px 32px 28px;
            border: 1px solid rgba(158, 255, 190, .28);
            border-radius: 18px;
            background: radial-gradient(ellipse at 50% -20%, rgba(60, 255, 130, .13), transparent 58%), linear-gradient(145deg, rgba(22, 27, 27, .98), rgba(7, 9, 10, .99));
            box-shadow: 0 30px 100px rgba(0, 0, 0, .72), 0 0 45px rgba(57, 255, 125, .09), inset 0 1px rgba(255, 255, 255, .06);
            text-align: center;
            animation: dialogIn .28s cubic-bezier(.2,.8,.2,1) both;
        }

        .confirm-dialog::before {
            content: "";
            position: absolute;
            top: 0;
            left: 15%;
            width: 70%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(119, 255, 164, .8), transparent);
        }

        .confirm-icon {
            width: 66px;
            height: 66px;
            margin: 0 auto 20px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 113, 113, .45);
            border-radius: 20px;
            background: linear-gradient(145deg, rgba(255, 82, 82, .16), rgba(255, 82, 82, .035));
            color: #ff8585;
            font-size: 30px;
            font-weight: 300;
            box-shadow: 0 0 28px rgba(255, 72, 72, .09), inset 0 0 16px rgba(255, 72, 72, .04);
            animation: warningPulse 2s ease-in-out infinite;
        }

        .confirm-dialog h2 {
            margin: 0;
            color: #f4f7f5;
            font-size: 21px;
            font-weight: 600;
            letter-spacing: -.35px;
        }

        .confirm-dialog p {
            max-width: 320px;
            margin: 12px auto 0;
            color: #a4b0aa;
            font-size: 12px;
            line-height: 1.9;
        }

        .confirm-actions {
            display: flex;
            gap: 12px;
            margin-top: 28px;
        }

        .confirm-actions button {
            flex: 1;
            min-height: 46px;
            padding: 12px 14px;
            border-radius: 9px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .8px;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }

        .confirm-actions button:hover {
            transform: translateY(-2px);
        }

        .confirm-actions button:focus-visible {
            outline: 2px solid #9cffb8;
            outline-offset: 3px;
        }

        .cancel-button {
            border: 1px solid rgba(255, 255, 255, .13);
            background: rgba(255, 255, 255, .045);
            color: #e0e8e3;
        }

        .cancel-button:hover {
            background: rgba(255, 255, 255, .09);
        }

        .confirm-delete-button {
            border: 1px solid rgba(255, 119, 119, .75);
            background: linear-gradient(135deg, #ff8585, #f05b66);
            color: #1b090b;
            box-shadow: 0 5px 20px rgba(255, 75, 90, .15);
        }

        .confirm-delete-button:hover {
            background: linear-gradient(135deg, #ffa0a0, #ff6977);
            box-shadow: 0 7px 24px rgba(255, 75, 90, .25);
        }

        .confirm-delete-button:disabled {
            opacity: .65;
            cursor: wait;
            transform: none;
        }

        @@media (max-width: 480px) {
            .confirm-dialog {
                padding: 28px 22px 22px;
                border-radius: 15px;
            }

            .confirm-actions {
                flex-direction: column-reverse;
            }
        }

        /* ANIMACIONES */

        @@keyframes nebulaFloat {
            from {
                transform: translate(-10px, 0) scale(.95);
            }

            to {
                transform: translate(25px, 25px) scale(1.08);
            }
        }

        @@keyframes statusPulse {
            0%, 100% {
                opacity: .45;
            }

            50% {
                opacity: 1;
            }
        }

        @@keyframes enterUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes rowAppear {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes emptyFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        @@keyframes overlayIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes dialogIn {
            from {
                opacity: 0;
                transform: translateY(12px) scale(.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes warningPulse {
            0%, 100% {
                box-shadow: 0 0 0 rgba(255, 120, 120, 0);
            }

            50% {
                box-shadow: 0 0 22px rgba(255, 120, 120, .12);
            }
        }

        /* RESPONSIVE */

        @@media (max-width: 1150px) {
            .sidebar {
                width: 210px;
            }

            .main-content {
                width: calc(100% - 210px);
                margin-left: 210px;
                padding-right: 25px;
                padding-left: 25px;
            }

            .content-grid {
                grid-template-columns: minmax(250px, .8fr) minmax(0, 1.3fr);
                gap: 15px;
            }

            .summary-card {
                padding: 18px;
            }

            .expense-form {
                padding: 18px;
            }
        }

        @@media (max-width: 900px) {
            .content-grid {
                grid-template-columns: 1fr;
            }

            .summary-grid {
                gap: 12px;
            }

            .summary-card {
                padding: 16px;
            }

            .summary-value {
                font-size: 22px;
            }
        }

        @@media (max-width: 680px) {
            .app-shell {
                display: block;
            }

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
                padding: 17px;
                border-right: 0;
                border-bottom: 1px solid var(--line);
            }

            .brand {
                padding: 0 5px 15px;
            }

            .brand-name {
                font-size: 23px;
            }

            .nav-label,
            .sidebar-bottom {
                display: none;
            }

            .nav-menu {
                flex-direction: row;
                overflow-x: auto;
                padding-top: 13px;
            }

            .nav-link {
                flex: 0 0 auto;
                padding: 10px 12px;
                font-size: 10px;
            }

            .nav-link:hover {
                transform: none;
            }

            .nav-icon {
                width: auto;
            }

            .main-content {
                width: 100%;
                margin-left: 0;
                padding: 22px 16px 35px;
            }

            .topbar {
                padding-bottom: 17px;
            }

            .secure-pill {
                font-size: 8px;
                padding: 8px;
            }

            .page-heading {
                align-items: flex-start;
                flex-direction: column;
                margin: 26px 0 22px;
            }

            .page-heading h1 {
                font-size: 33px;
            }

            .date-display {
                white-space: normal;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .summary-card {
                padding: 19px;
            }

            .summary-value {
                font-size: 27px;
            }

            .panel-heading {
                padding: 18px;
            }

            .table-toolbar {
                padding: 16px;
            }

            .expense-table th,
            .expense-table td {
                padding: 13px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
    
      <link rel="stylesheet"
          href="~/css/gastos.css"
          asp-append-version="true" />
</head>

<body>
   
    <!-- FONDO ESPACIAL -->
    <div class="space-background" aria-hidden="true">
        <canvas id="starsCanvas"></canvas>

        <div class="nebula nebula-one"></div>
        <div class="nebula nebula-two"></div>
    </div>

    <!-- AGUJERO NEGRO: INDEPENDIENTE DEL FONDO -->
    <div class="black-hole-scene" aria-hidden="true">

        <div class="black-hole-aura"></div>

        <div class="black-hole">

            <div class="black-hole-lens"></div>

            <!-- Materia que pasa por detrás -->
            <div class="black-hole-disk black-hole-disk-back"></div>

            <!-- Horizonte de sucesos -->
            <div class="black-hole-core"></div>

            <!-- Disco de acreción frontal -->
            <div class="black-hole-disk black-hole-disk-front"></div>

            <!-- Reflejo gravitacional -->
            <div class="black-hole-glow"></div>

        </div>

        <!-- Órbitas exteriores -->
        <div class="black-hole-orbit orbit-one"></div>
        <div class="black-hole-orbit orbit-two"></div>

    </div>

    <!-- INTERFAZ ORIGINAL DE NOVIX -->
    <div class="app-shell">


        <aside class="sidebar">
            <a href="/Home/Index" class="brand">
                <span class="brand-name">NOVIX<span>.</span></span>
                <span class="brand-caption">FINANCIAL INTELLIGENCE</span>
            </a>

            <div class="nav-label">MENÚ PRINCIPAL</div>

            <nav class="nav-menu">
               <a href="/Dashboard/Index" class="nav-link">
    <span class="nav-icon">⌂</span>
    Dashboard
</a>

                <a href="/Ingresos/Index" class="nav-link">
                    <span class="nav-icon">↗</span>
                    Ingresos
                </a>

                <a href="/Gastos/Index" class="nav-link active">
                    <span class="nav-icon">↘</span>
                    Gastos
                </a>

                <a href="/Registros/Index" class="nav-link">
                    <span class="nav-icon">▤</span>
                    Registros
                </a>

                <a href="/Home/Analisis" class="nav-link">
                    <span class="nav-icon">⌁</span>
                    Análisis
                </a>

               
                <a href="/Home/Reportes" class="nav-link">
                    <span class="nav-icon">▧</span>
                    Reportes
                </a>
            </nav>

            <div class="sidebar-bottom">
                <div class="system-status">
                    <span class="status-dot"></span>
                    SISTEMA ACTIVO
                </div>
                <div class="system-version">NOVIX CORE / FINANCE 01</div>
            </div>
        </aside>

        <main class="main-content">

            <header class="topbar">
                <div class="breadcrumb">
                    NOVIX CORE <span>/ GASTOS</span>
                </div>

                <div class="topbar-right">
                    <div class="secure-pill">
                        <span class="status-dot"></span>
                        CONEXIÓN LOCAL
                    </div>
                    <div class="user-avatar">N</div>
                </div>
            </header>

            <section class="page-heading">
                <div>
                    <div class="eyebrow">
                        <span class="eyebrow-line"></span>
                        CONTROL FINANCIERO
                    </div>

                    <h1>Centro de <span>gastos.</span></h1>

                    <p class="page-description">
                        Supervisa tus egresos, registra operaciones y mantén
                        el control de cada movimiento de tu universo financiero.
                    </p>
                </div>

                <div class="date-display">
                    ◷ @DateTime.Now.ToString("dd MMMM yyyy", cultura)
                </div>
            </section>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert" role="status">
                    @TempData["Mensaje"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert error" role="alert">
                    @TempData["Error"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert error" role="alert">
                    @ViewBag.Error
                </div>
            }

            <section class="summary-grid">
                <article class="summary-card">
                    <div class="summary-top">
                        <span class="summary-label">TOTAL DE GASTOS</span>
                        <span class="summary-icon">↘</span>
                    </div>

                    <div class="summary-value">
                        @totalGastos.ToString("C2", cultura)
                    </div>

                    <div class="summary-note">
                        Suma de los gastos registrados
                    </div>
                </article>

                <article class="summary-card">
                    <div class="summary-top">
                        <span class="summary-label">OPERACIONES</span>
                        <span class="summary-icon">▤</span>
                    </div>

                    <div class="summary-value">
                        @cantidadGastos
                    </div>

                    <div class="summary-note">
                        Gastos almacenados en la base de datos
                    </div>
                </article>

                <article class="summary-card">
                    <div class="summary-top">
                        <span class="summary-label">PROMEDIO POR GASTO</span>
                        <span class="summary-icon">◈</span>
                    </div>

                    <div class="summary-value">
                        @promedioGastos.ToString("C2", cultura)
                    </div>

                    <div class="summary-note">
                        Promedio de las operaciones registradas
                    </div>
                </article>
            </section>

            <section class="content-grid">

                <!-- FORMULARIO PARA REGISTRAR GASTOS -->

                <article class="glass-panel">
                    <div class="panel-heading">
                        <h2>Registrar gasto</h2>
                        <p>
                            Ingresa los datos de la operación.
                            El registro se guardará en NOVIXDB.
                        </p>
                    </div>

                    <form asp-controller="Gastos"
                          asp-action="Crear"
                          method="post"
                          class="expense-form">

                        @Html.AntiForgeryToken()

                        <div class="form-field">
                            <label for="Fecha">FECHA DEL GASTO</label>
                            <input class="field-control"
                                   type="date"
                                   id="Fecha"
                                   name="Fecha"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="form-field">
                            <label for="Descripcion">DESCRIPCIÓN</label>
                            <input class="field-control"
                                   type="text"
                                   id="Descripcion"
                                   name="Descripcion"
                                   placeholder="Ej. Pago de electricidad"
                                   maxlength="200"
                                   required />
                        </div>

                        <div class="form-field">
                            <label for="Categoria">CATEGORÍA</label>
                            <select class="field-control"
                                    id="Categoria"
                                    name="Categoria"
                                    required>
                                <option value="">Selecciona una categoría</option>
                                <option value="Alimentación">Alimentación</option>
                                <option value="Transporte">Transporte</option>
                                <option value="Servicios">Servicios</option>
                                <option value="Vivienda">Vivienda</option>
                                <option value="Educación">Educación</option>
                                <option value="Salud">Salud</option>
                                <option value="Entretenimiento">Entretenimiento</option>
                                <option value="Compras">Compras</option>
                                <option value="Otros">Otros</option>
                            </select>
                        </div>

                        <div class="form-field">
                            <label for="Monto">MONTO (Q)</label>
                            <input class="field-control"
                                   type="number"
                                   id="Monto"
                                   name="Monto"
                                   placeholder="0.00"
                                   min="0.01"
                                   max="9999999999"
                                   step="0.01"
                                   required />
                            <span class="form-hint">
                                Ingresa una cantidad mayor que cero.
                            </span>
                        </div>

                        <button type="submit" class="primary-button">
                            <span>＋</span>
                            REGISTRAR GASTO
                            <span class="button-shine"></span>
                        </button>
                    </form>
                </article>

                <!-- TABLA DE GASTOS -->

                <article class="glass-panel">
                    <div class="table-toolbar">
                        <h2>Historial de gastos</h2>

                        <span class="table-count">
                            @cantidadGastos REGISTROS
                        </span>
                    </div>

                    @if (Model != null && Model.Count > 0)
                    {
                        <div class="table-scroll">
                            <table class="expense-table">
                                <thead>
                                    <tr>
                                        <th>FECHA</th>
                                        <th>DESCRIPCIÓN</th>
                                        <th>CATEGORÍA</th>
                                        <th>MONTO</th>
                                        <th>ACCIÓN</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var gasto in Model)
                                    {
                                        <tr>
                                            <td>
                                                @gasto.Fecha.ToString("dd/MM/yyyy")
                                            </td>

                                            <td>
                                                <div class="expense-description">
                                                    @gasto.Descripcion
                                                </div>
                                            </td>

                                            <td>
                                                <span class="category-tag">
                                                    @gasto.Categoria
                                                </span>
                                            </td>

                                            <td class="expense-amount">
                                                @gasto.Monto.ToString("C2", cultura)
                                            </td>

                                            <td>
                                                <form asp-controller="Gastos"
                                                       asp-action="Eliminar"
                                                       method="post"
                                                       class="delete-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@gasto.Id" />

                                                    <button type="button"
                                                             class="delete-button"
                                                             onclick="abrirConfirmacionGasto(this)">
                                                         Eliminar
                                                     </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <div class="empty-icon">✧</div>
                            <h3>Tu espacio está despejado</h3>
                            <p>
                                Todavía no hay gastos registrados.
                                Utiliza el formulario para agregar tu primera operación.
                            </p>
                        </div>
                    }

                    <div class="table-footer">
                        Los registros se consultan desde la base de datos.
                        Los cambios se reflejan al actualizar la página.
                    </div>
                </article>

            </section>
        </main>
    </div>

    <!-- MODAL DE CONFIRMACIÓN -->

    <div id="confirmOverlay"
         class="confirm-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="confirmTitle"
         aria-describedby="confirmDescription">

        <div class="confirm-dialog">
            <div class="confirm-icon" aria-hidden="true">!</div>

            <h2 id="confirmTitle">¿Eliminar este gasto?</h2>

            <p id="confirmDescription">
                El registro se eliminará de la base de datos.
                Esta acción no se puede deshacer.
            </p>

            <div class="confirm-actions">
                <button type="button"
                        id="cancelDelete"
                        class="cancel-button">
                    CANCELAR
                </button>

                <button type="button"
                        id="confirmDelete"
                        class="confirm-delete-button">
                    SÍ, ELIMINAR
                </button>
            </div>
        </div>
    </div>

    <script>
        /* ESTRELLAS ASTRales */

        (function () {
            const canvas = document.getElementById("starsCanvas");

            if (!canvas) {
                return;
            }

            const context = canvas.getContext("2d");

            if (!context) {
                return;
            }

            let stars = [];
            let width = 0;
            let height = 0;
            let animationFrame = 0;

            const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)"
            ).matches;

            function resizeCanvas() {
                const ratio = Math.min(window.devicePixelRatio || 1, 2);

                width = window.innerWidth;
                height = window.innerHeight;

                canvas.width = width * ratio;
                canvas.height = height * ratio;

                canvas.style.width = width + "px";
                canvas.style.height = height + "px";

                context.setTransform(ratio, 0, 0, ratio, 0, 0);

                const cantidad = Math.min(
                    160,
                    Math.floor((width * height) / 9000)
                );

                stars = [];

                for (let i = 0; i < cantidad; i++) {
                    stars.push({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        size: Math.random() * 1.4 + .2,
                        opacity: Math.random() * .6 + .15,
                        speed: Math.random() * .004 + .001,
                        phase: Math.random() * Math.PI * 2
                    });
                }
            }

            function drawStars(time) {
                context.clearRect(0, 0, width, height);

                for (const star of stars) {
                    const brillo = reducedMotion
                        ? star.opacity
                        : star.opacity *
                          (.65 + .35 * Math.sin(time * star.speed + star.phase));

                    context.beginPath();
                    context.arc(
                        star.x,
                        star.y,
                        star.size,
                        0,
                        Math.PI * 2
                    );

                    context.fillStyle = "rgba(230,230,245," + brillo + ")";
                    context.fill();
                }

                if (!reducedMotion) {
                    animationFrame = requestAnimationFrame(drawStars);
                }
            }

            resizeCanvas();
            drawStars(0);

            window.addEventListener("resize", function () {
                cancelAnimationFrame(animationFrame);
                resizeCanvas();
                drawStars(0);
            });
        })();
    </script>

    <script>
        /* MODAL DE CONFIRMACIÓN Y ELIMINACIÓN */
        let formularioGastoPendiente = null;

        function abrirConfirmacionGasto(boton) {
            const formulario = boton.closest("form.delete-form");
            const overlay = document.getElementById("confirmOverlay");
            const cancelar = document.getElementById("cancelDelete");
            const confirmar = document.getElementById("confirmDelete");

            if (!formulario || !overlay || !cancelar || !confirmar) {
                console.error("No se encontró el formulario o el modal de eliminación.");
                alert("No se pudo abrir la confirmación. Recarga la página e inténtalo de nuevo.");
                return;
            }

            formularioGastoPendiente = formulario;
            confirmar.disabled = false;
            confirmar.textContent = "SÍ, ELIMINAR";

            overlay.classList.add("open");
            overlay.style.setProperty("display", "flex", "important");
            overlay.style.setProperty("visibility", "visible", "important");
            overlay.style.setProperty("opacity", "1", "important");
            overlay.style.setProperty("pointer-events", "auto", "important");
            overlay.style.setProperty("z-index", "999999", "important");

            document.body.style.overflow = "hidden";
            cancelar.focus();
        }

        (function () {
            const overlay = document.getElementById("confirmOverlay");
            const cancelar = document.getElementById("cancelDelete");
            const confirmar = document.getElementById("confirmDelete");

            if (!overlay || !cancelar || !confirmar) {
                console.error("No se encontraron los controles del modal de eliminación.");
                return;
            }

            function cerrarModal() {
                overlay.classList.remove("open");
                overlay.style.setProperty("display", "none", "important");
                overlay.style.removeProperty("visibility");
                overlay.style.removeProperty("opacity");
                overlay.style.removeProperty("pointer-events");
                overlay.style.removeProperty("z-index");
                document.body.style.overflow = "";
                formularioGastoPendiente = null;
            }

            cancelar.addEventListener("click", cerrarModal);

            confirmar.addEventListener("click", function () {
                if (!formularioGastoPendiente) {
                    return;
                }

                const formulario = formularioGastoPendiente;
                confirmar.disabled = true;
                confirmar.textContent = "ELIMINANDO...";

                HTMLFormElement.prototype.submit.call(formulario);
            });

            overlay.addEventListener("click", function (event) {
                if (event.target === overlay) {
                    cerrarModal();
                }
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && overlay.classList.contains("open")) {
                    cerrarModal();
                }
            });
        })();
    </script>
</body>
</html>
