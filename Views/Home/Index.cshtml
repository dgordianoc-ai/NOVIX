                    example: `
                        <h4>RESUMEN DEL EJEMPLO</h4>
                        <p>Imagina que el reporte mensual muestra Q 5,000 de ingresos, Q 3,200 de gastos y Q 1,800 de diferencia. Antes de tomar decisiones, verifica que el periodo esté bien seleccionado y que todos los movimientos estén incluidos.</p>
                        <p><strong>Has completado el recorrido básico de NOVIX.</strong> Puedes volver a cualquier lección desde el menú para repasar sus conceptos.</p>
                    `
                }
            ];

            function formatMoney(value) {
                const amount = Number(value);

                return "Q " + (Number.isFinite(amount) ? amount : 0)
                    .toLocaleString("es-GT", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
            }

            function getNumber(id) {
                const input = document.getElementById(id);

                if (!input) {
                    return 0;
                }

                const value = Number(input.value);

                return Number.isFinite(value) && value >= 0 ? value : 0;
            }

            function setText(id, value) {
                const element = document.getElementById(id);

                if (element) {
                    element.textContent = value;
                }
            }

            function updatePractice() {
                const incomeInput = document.getElementById("practice-income");

                if (incomeInput) {
                    const base = getNumber("practice-income-base");
                    const extra = getNumber("practice-income");

                    setText("income-base-result", formatMoney(base));
                    setText("income-new-result", formatMoney(extra));
                    setText("income-total-result", formatMoney(base + extra));

                    setText(
                        "income-message",
                        "El total de ingresos de este ejemplo es " +
                        formatMoney(base + extra) + "."
                    );
                }

                const expenseInput = document.getElementById("practice-expense-one");

                if (expenseInput) {
                    const first = getNumber("practice-expense-one");
                    const second = getNumber("practice-expense-two");
                    const budget = getNumber("practice-expense-budget");
                    const total = first + second;
                    const remaining = budget - total;

                    setText("expense-total-result", formatMoney(total));
                    setText("expense-budget-result", formatMoney(budget));
                    setText("expense-remaining-result", formatMoney(remaining));

                    setText(
                        "expense-message",
                        remaining >= 0
                            ? "Estás dentro del presupuesto por " + formatMoney(remaining) + "."
                            : "Has superado el presupuesto por " + formatMoney(Math.abs(remaining)) + "."
                    );
                }

                const balanceInput = document.getElementById("practice-balance-income");

                if (balanceInput) {
                    const income = getNumber("practice-balance-income");
                    const expenses = getNumber("practice-balance-expenses");
                    const balance = income - expenses;

                    setText("balance-income-result", formatMoney(income));
                    setText("balance-expenses-result", formatMoney(expenses));
                    setText("balance-total-result", formatMoney(balance));

                    let message;

                    if (balance > 0) {
                        message = "Tus ingresos superan a tus gastos por " +
                            formatMoney(balance) + ".";
                    } else if (balance < 0) {
                        message = "Tus gastos superan a tus ingresos por " +
                            formatMoney(Math.abs(balance)) + ".";
                    } else {
                        message = "Tus ingresos y gastos son iguales.";
                    }

                    setText("balance-message", message);
                }
            }

            function renderLesson() {
                const lesson = lessons[currentLesson];

                lessonNumber.textContent =
                    "LECCIÓN " + String(currentLesson + 1).padStart(2, "0") +
                    " / " + String(lessons.length).padStart(2, "0");

                lessonTitle.textContent = lesson.title;
                lessonText.textContent = lesson.text;
                lessonExample.innerHTML = lesson.example;

                progressText.textContent =
                    "Lección " + (currentLesson + 1) +
                    " de " + lessons.length;

                progressFill.style.width =
                    (((currentLesson + 1) / lessons.length) * 100) + "%";

                previousButton.disabled = currentLesson === 0;

                nextButton.textContent =
                    currentLesson === lessons.length - 1
                        ? "Volver al explorador ↗"
                        : "Siguiente →";

                moduleButtons.forEach((button, index) => {
                    const active = index === currentLesson;

                    button.classList.toggle("is-active", active);

                    if (active) {
                        button.setAttribute("aria-current", "step");
                    } else {
                        button.removeAttribute("aria-current");
                    }
                });

                updatePractice();
            }

            function openExplorer(event) {
                if (event) {
                    event.preventDefault();
                }

                clearTimeout(closeTimer);

                academy.classList.remove("is-open");
                academy.setAttribute("aria-hidden", "true");

                exploreSection.style.removeProperty("display");
                exploreSection.classList.remove("is-leaving");
                exploreSection.classList.add("is-visible");

                document.body.classList.add("explorer-open");

                history.replaceState(null, "", "#explorar-novix");

                requestAnimationFrame(() => {
                    exploreSection.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                });
            }

            function closeExplorer(event) {
                if (event) {
                    event.preventDefault();
                }

                exploreSection.classList.remove("is-visible");
                exploreSection.classList.add("is-leaving");

                document.body.classList.remove("explorer-open");

                closeTimer = setTimeout(() => {
                    exploreSection.classList.remove("is-leaving");
                    exploreSection.style.display = "none";

                    welcomeSection.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });

                    history.replaceState(null, "", location.pathname);
                }, 400);
            }

            function openAcademy(index) {
                currentLesson = Number.isInteger(index) ? index : 0;

                currentLesson = Math.max(
                    0,
                    Math.min(currentLesson, lessons.length - 1)
                );

                exploreSection.classList.remove("is-visible");
                exploreSection.style.display = "none";

                academy.classList.add("is-open");
                academy.setAttribute("aria-hidden", "false");

                document.body.classList.add("explorer-open");

                renderLesson();

                history.replaceState(null, "", "#novix-academy");

                requestAnimationFrame(() => {
                    academy.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                });
            }

            function closeAcademy() {
                academy.classList.remove("is-open");
                academy.setAttribute("aria-hidden", "true");

                exploreSection.style.removeProperty("display");
                exploreSection.classList.remove("is-leaving");
                exploreSection.classList.add("is-visible");

                document.body.classList.add("explorer-open");

                history.replaceState(null, "", "#explorar-novix");

                requestAnimationFrame(() => {
                    exploreSection.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                });
            }

            exploreButton?.addEventListener("click", openExplorer);
            backButton?.addEventListener("click", closeExplorer);
            academyClose?.addEventListener("click", closeAcademy);

            cards.forEach((card, index) => {
                card.addEventListener("click", function () {
                    openAcademy(index);
                });

                card.setAttribute(
                    "aria-label",
                    "Abrir lección interactiva " + (index + 1)
                );
            });

            moduleButtons.forEach(button => {
                button.addEventListener("click", function () {
                    openAcademy(Number(button.dataset.lesson));
                });
            });

            previousButton?.addEventListener("click", function () {
                if (currentLesson > 0) {
                    currentLesson--;
                    renderLesson();
                }
            });

            nextButton?.addEventListener("click", function () {
                if (currentLesson < lessons.length - 1) {
                    currentLesson++;
                    renderLesson();
                } else {
                    openExplorer();
                }
            });

            academy.addEventListener("input", updatePractice);
            academy.addEventListener("change", updatePractice);

            document.addEventListener("keydown", function (event) {
                if (
                    event.key === "Escape" &&
                    academy.classList.contains("is-open")
                ) {
                    closeAcademy();
                }
            });

            renderLesson();

            if (window.location.hash === "#explorar-novix") {
                openExplorer();
            }

            if (window.location.hash === "#novix-academy") {
                openExplorer();
                openAcademy(0);
            }
        });
    </script>
</body>
</html>