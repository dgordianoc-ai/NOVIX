@{
    Layout = null;
    ViewData["Title"] = "NOVIX | Financial Management";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#030305" />

    <title>NOVIX | Financial Management</title>

    <link rel="stylesheet"
          href="~/css/novix.css"
          asp-append-version="true" />

    <style>
        /* ==========================================
           CONFIGURACIÓN GENERAL
        ========================================== */

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 15px;
        }

        body {
            overflow-x: hidden;
        }

        body.explorer-open {
            overflow-x: hidden;
        }

        /* ==========================================
           EXPLORADOR NOVIX
        ========================================== */

        .explore-section {
            position: relative;
            z-index: 2;
            display: none;
            width: 100%;
            min-height: 100vh;
            padding: 32px 7% 35px;
            color: #f3f3f6;
            background:
                radial-gradient(
                    ellipse at 50% 10%,
                    rgba(210, 210, 225, .09),
                    transparent 43%
                ),
                #050507;
            border-top: 1px solid #29292f;
            opacity: 0;
            transform: translateY(20px);
        }

        .explore-section.is-visible {
            display: block;
            animation: explorerEnter .55s ease forwards;
        }

        .explore-section.is-leaving {
            display: block;
            pointer-events: none;
            animation: explorerLeave .4s ease forwards;
        }

        @@keyframes explorerEnter {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes explorerLeave {
            from {
                opacity: 1;
                transform: translateY(0);
            }

            to {
                opacity: 0;
                transform: translateY(15px);
            }
        }

        /* ==========================================
           ENCABEZADO DEL EXPLORADOR
        ========================================== */

        .explore-topline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            max-width: 1250px;
            margin: 0 auto 30px;
        }

        .explore-brand {
            color: #eeeeF3;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 4px;
        }

        .explore-brand span {
            color: #8e8e99;
        }

        .explore-close {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 11px 16px;
            color: #e5e5eb;
            background: rgba(255, 255, 255, .025);
            border: 1px solid #383840;
            border-radius: 5px;
            cursor: pointer;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.2px;
            transition:
                background .25s ease,
                color .25s ease,
                transform .25s ease;
        }

        .explore-close:hover {
            color: #050507;
            background: #f0f0f4;
            transform: translateY(-2px);
        }

        /* ==========================================
           TÍTULO Y DESCRIPCIÓN
        ========================================== */

        .explore-heading {
            max-width: 850px;
            margin: 0 auto 30px;
            text-align: center;
        }

        .explore-eyebrow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            color: #b8b8c2;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2.5px;
        }

        .explore-eyebrow::before {
            content: "";
            width: 25px;
            height: 1px;
            background: #d7d7df;
        }

        .explore-heading h2 {
            margin: 16px 0 12px;
            color: #f5f5f7;
            font-size: clamp(34px, 4vw, 52px);
            font-weight: 500;
            letter-spacing: -2px;
            line-height: 1.08;
        }

        .explore-heading h2 span {
            color: #92929e;
        }

        .explore-heading p {
            max-width: 570px;
            margin: 0 auto;
            color: #a1a1ad;
            font-size: 13px;
            line-height: 1.7;
        }

        .explore-status {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            margin-top: 15px;
            color: #81818d;
            font-size: 9px;
            letter-spacing: 1.5px;
        }

        .explore-status-dot {
            width: 6px;
            height: 6px;
            background: #e8e8ef;
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(255, 255, 255, .7);
            animation: statusPulse 2s infinite;
        }

        @@keyframes statusPulse {
            0%, 100% {
                opacity: .45;
            }

            50% {
                opacity: 1;
            }
        }

        /* ==========================================
           TARJETAS
        ========================================== */

        .explore-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            max-width: 1250px;
            margin: 0 auto;
        }

        .explore-card {
            --card-delay: 0ms;

            position: relative;
            isolation: isolate;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            min-width: 0;
            min-height: 205px;
            padding: 22px 24px;
            overflow: hidden;
            text-align: left;
            color: #f2f2f5;
            background:
                radial-gradient(
                    ellipse at 90% 0%,
                    rgba(220, 220, 235, .075),
                    transparent 45%
                ),
                linear-gradient(145deg, #141417, #09090b 75%);
            border: 1px solid #303038;
            border-radius: 10px;
            cursor: pointer;
            opacity: 0;
            transform: translateY(18px);
            animation:
                cardReveal .55s ease forwards;
            animation-delay: var(--card-delay);
            transition:
                border-color .3s ease,
                transform .3s ease,
                box-shadow .3s ease,
                background .3s ease;
        }

        .explore-card::before {
            content: "";
            position: absolute;
            z-index: -1;
            top: -100%;
            left: -60%;
            width: 60%;
            height: 300%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, .05),
                transparent
            );
            transform: rotate(25deg);
            transition: left .7s ease;
            pointer-events: none;
        }

        .explore-card:hover::before {
            left: 130%;
        }

        .explore-card:hover,
        .explore-card:focus-visible {
            outline: none;
            border-color: #858590;
            transform: translateY(-4px);
            box-shadow: 0 15px 45px rgba(0, 0, 0, .4);
        }

        .explore-card:focus-visible {
            box-shadow: 0 0 0 2px #ededf2;
        }

        .explore-card.is-active {
            border-color: #c5c5d0;
            background:
                radial-gradient(
                    ellipse at 90% 0%,
                    rgba(230, 230, 240, .11),
                    transparent 50%
                ),
                #111114;
        }

        @@keyframes cardReveal {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .explore-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            gap: 12px;
        }

        .explore-card-number {
            color: #92929e;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .explore-card-icon {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 38px;
            height: 38px;
            color: #ededf2;
            background: rgba(255, 255, 255, .035);
            border: 1px solid #41414b;
            border-radius: 7px;
            font-size: 20px;
            transition:
                transform .3s ease,
                background .3s ease;
        }

        .explore-card:hover .explore-card-icon,
        .explore-card.is-active .explore-card-icon {
            transform: rotate(-8deg) scale(1.05);
            background: rgba(255, 255, 255, .09);
        }

        .explore-card h3 {
            margin: 15px 0 7px;
            color: #f3f3f6;
            font-size: 21px;
            font-weight: 600;
            letter-spacing: -.5px;
        }

        .explore-card-description {
            display: block;
            max-width: 430px;
            margin: 0;
            color: #a3a3af;
            font-size: 12px;
            line-height: 1.7;
        }

        .explore-card-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            width: 100%;
            margin-top: auto;
            padding-top: 16px;
            color: #b9b9c3;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.4px;
        }

        .explore-card-arrow {
            display: inline-grid;
            place-items: center;
            flex-shrink: 0;
            width: 27px;
            height: 27px;
            border: 1px solid #40404a;
            border-radius: 50%;
            font-size: 15px;
            transition:
                transform .3s ease,
                background .3s ease;
        }

        .explore-card:hover .explore-card-arrow,
        .explore-card.is-active .explore-card-arrow {
            transform: rotate(45deg);
            color: #08080a;
            background: #eeeeF2;
        }

        /* ==========================================
           INFORMACIÓN EXPANDIBLE DE LAS TARJETAS
        ========================================== */

        .explore-details {
            display: grid;
            grid-template-rows: 0fr;
            width: 100%;
            opacity: 0;
            transition:
                grid-template-rows .35s ease,
                opacity .3s ease;
        }

        .explore-card.is-active .explore-details {
            grid-template-rows: 1fr;
            opacity: 1;
        }

        .explore-details-inner {
            overflow: hidden;
        }

        .explore-details p {
            margin: 14px 0 0;
            padding-top: 14px;
            color: #dedee5;
            border-top: 1px solid #35353d;
            font-size: 12px;
            line-height: 1.8;
        }

        .explore-details strong {
            color: #fff;
        }

        /* ==========================================
           PARTE INFERIOR DEL EXPLORADOR
        ========================================== */

        .explore-hint {
            margin-top: 22px;
            color: #777783;
            text-align: center;
            font-size: 9px;
            letter-spacing: 1.4px;
        }

        .explore-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            max-width: 1250px;
            margin: 30px auto 0;
            padding-top: 18px;
            border-top: 1px solid #29292f;
        }

        .explore-bottom p {
            margin: 0;
            color: #888894;
            font-size: 10px;
            line-height: 1.8;
        }

        .explore-login {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            min-height: 43px;
            padding: 0 20px;
            color: #08080a;
            background: #f0f0f4;
            border: 1px solid #f0f0f4;
            text-decoration: none;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1.3px;
            transition:
                background .25s ease,
                transform .25s ease;
        }

        .explore-login:hover {
            transform: translateY(-2px);
            background: #fff;
        }

        .explore-login span {
            font-size: 16px;
        }

        /* ==========================================
           ACADEMIA FINANCIERA
        ========================================== */

        .academy {
            position: relative;
            z-index: 3;
            display: none;
            min-height: 100vh;
            padding: 45px 6%;
            color: #f5f5f7;
            background:
                radial-gradient(
                    ellipse at 50% 0%,
                    rgba(210, 210, 230, .10),
                    transparent 45%
                ),
                #050507;
            border-top: 1px solid rgba(255, 255, 255, .12);
        }

        .academy.is-open {
            display: block;
            animation: academyEnter .45s ease both;
        }

        @@keyframes academyEnter {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .academy-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            max-width: 1200px;
            margin: 0 auto 28px;
        }

        .academy-label,
        .academy-eyebrow {
            color: #aaaab7;
            font-size: 10px;
            letter-spacing: 3px;
        }

        .academy-close,
        .lesson-button {
            padding: 11px 16px;
            color: #f5f5f7;
            background: #111115;
            border: 1px solid #44444f;
            border-radius: 4px;
            cursor: pointer;
            transition: all .25s ease;
        }

        .academy-close:hover,
        .lesson-button:hover {
            color: #050507;
            background: #f0f0f4;
            transform: translateY(-2px);
        }

        .academy-intro {
            max-width: 850px;
            margin: 0 auto 25px;
            text-align: center;
        }

        .academy-intro h2 {
            margin: 16px 0;
            font-size: clamp(32px, 4vw, 54px);
            font-weight: 300;
            letter-spacing: -2px;
        }

        .academy-intro h2 span {
            color: #c9c9d3;
        }

        .academy-intro p {
            color: #a5a5b2;
            font-size: 13px;
            line-height: 1.8;
        }

        .academy-progress {
            max-width: 800px;
            margin: 25px auto;
        }

        .academy-progress-info {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 10px;
            color: #bcbcc7;
            font-size: 10px;
            letter-spacing: 1px;
        }

        .academy-progress-track {
            height: 3px;
            overflow: hidden;
            background: #25252c;
        }

        .academy-progress-fill {
            width: 0;
            height: 100%;
            background: linear-gradient(90deg, #777783, #fff);
            transition: width .35s ease;
        }

        .academy-layout {
            display: grid;
            grid-template-columns: minmax(220px, .7fr) minmax(0, 1.5fr);
            gap: 22px;
            max-width: 1200px;
            margin: 0 auto;
            align-items: start;
        }

        .academy-modules {
            display: grid;
            gap: 9px;
        }

        .academy-module {
            width: 100%;
            padding: 15px;
            text-align: left;
            color: #d9d9e2;
            background: rgba(255, 255, 255, .025);
            border: 1px solid #303039;
            border-radius: 5px;
            cursor: pointer;
            transition: all .25s ease;
        }

        .academy-module:hover,
        .academy-module.is-active {
            border-color: #b9b9c8;
            background: rgba(255, 255, 255, .075);
            transform: translateX(3px);
        }

        .academy-module span {
            display: block;
            margin-bottom: 7px;
            color: #888895;
            font-size: 9px;
            letter-spacing: 1.5px;
        }

        .academy-module strong {
            font-size: 13px;
            font-weight: 500;
        }

        .lesson-panel {
            min-height: 400px;
            padding: clamp(22px, 4vw, 38px);
            background:
                radial-gradient(
                    ellipse at 100% 0%,
                    rgba(255, 255, 255, .07),
                    transparent 45%
                ),
                #101014;
            border: 1px solid #393941;
            border-radius: 8px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, .25);
        }

        .lesson-number {
            color: #92929f;
            font-size: 10px;
            letter-spacing: 2px;
        }

        .lesson-panel h3 {
            margin: 18px 0;
            font-size: clamp(24px, 3vw, 35px);
            font-weight: 400;
        }

        .lesson-text {
            color: #b4b4c0;
            font-size: 13px;
            line-height: 1.9;
        }

        .lesson-example {
            margin-top: 22px;
            padding: 18px;
            background: rgba(255, 255, 255, .025);
            border: 1px solid #303039;
            border-radius: 5px;
        }

        .lesson-example h4 {
            margin: 0 0 12px;
            font-size: 12px;
            letter-spacing: 1px;
        }

        .lesson-example p {
            color: #b7b7c3;
            font-size: 12px;
            line-height: 1.8;
        }

        .lesson-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 12px;
            margin-top: 25px;
        }

        .lesson-button:disabled {
            opacity: .3;
            cursor: not-allowed;
            transform: none;
        }

        .practice-form {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 13px;
            margin-top: 18px;
        }

        .practice-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .practice-field label {
            color: #b8b8c4;
            font-size: 11px;
        }

        .practice-field input,
        .practice-field select {
            width: 100%;
            min-height: 42px;
            padding: 10px;
            color: #f5f5f7;
            background: #08080b;
            border: 1px solid #41414b;
            border-radius: 4px;
        }

        .practice-field input:focus,
        .practice-field select:focus {
            outline: 1px solid #c6c6d2;
            border-color: #c6c6d2;
        }

        .practice-field select option {
            color: #fff;
            background: #08080b;
        }

        .practice-full {
            grid-column: 1 / -1;
        }

        .practice-result {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            margin-top: 18px;
        }

        .practice-metric {
            min-width: 0;
            padding: 13px;
            background: rgba(255, 255, 255, .035);
            border: 1px solid #33333c;
            border-radius: 4px;
        }

        .practice-metric span {
            display: block;
            margin-bottom: 8px;
            color: #a1a1ad;
            font-size: 10px;
        }

        .practice-metric strong {
            font-size: clamp(13px, 1.8vw, 20px);
            overflow-wrap: anywhere;
        }

        .practice-message {
            margin-top: 14px;
            color: #d8d8e2;
            font-size: 12px;
            line-height: 1.8;
        }

        .academy-finish {
            max-width: 1200px;
            margin: 25px auto 0;
            padding-top: 18px;
            color: #92929e;
            border-top: 1px solid #29292f;
            font-size: 10px;
            line-height: 1.8;
        }

        /* ==========================================
           PANTALLAS CON POCA ALTURA
           Evita dejar las tarjetas demasiado abajo.
        ========================================== */

        @@media (max-height: 800px) and (min-width: 761px) {
            .explore-section {
                padding-top: 22px;
                padding-bottom: 25px;
            }

            .explore-topline {
                margin-bottom: 22px;
            }

            .explore-heading {
                margin-bottom: 22px;
            }

            .explore-heading h2 {
                margin-top: 11px;
                margin-bottom: 9px;
                font-size: clamp(32px, 3.8vw, 45px);
            }

            .explore-heading p {
                line-height: 1.55;
            }

            .explore-status {
                margin-top: 11px;
            }

            .explore-grid {
                gap: 12px;
            }

            .explore-card {
                min-height: 180px;
                padding: 18px 21px;
            }

            .explore-card h3 {
                margin-top: 12px;
                margin-bottom: 5px;
                font-size: 19px;
            }

            .explore-card-description {
                font-size: 11px;
                line-height: 1.55;
            }

            .explore-card-bottom {
                padding-top: 12px;
            }

            .explore-bottom {
                margin-top: 20px;
                padding-top: 12px;
            }

            .explore-hint {
                margin-top: 14px;
            }
        }

        /* ==========================================
           TABLETAS
        ========================================== */

        @@media (max-width: 900px) {
            .explore-section {
                padding-right: 4%;
                padding-left: 4%;
            }

            .explore-card {
                padding: 20px;
            }

            .academy-layout {
                grid-template-columns: minmax(180px, .7fr) minmax(0, 1.5fr);
            }
        }

        /* ==========================================
           CELULARES
        ========================================== */

        @@media (max-width: 760px) {
            .explore-section {
                padding: 28px 18px;
            }

            .explore-topline {
                margin-bottom: 32px;
            }

            .explore-heading {
                margin-bottom: 25px;
            }

            .explore-heading h2 {
                font-size: clamp(31px, 8vw, 43px);
                letter-spacing: -1.5px;
            }

            .explore-heading p {
                font-size: 12px;
            }

            .explore-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .explore-card {
                min-height: 190px;
                padding: 21px;
            }

            .explore-card h3 {
                font-size: 21px;
            }

            .explore-bottom {
                align-items: stretch;
                flex-direction: column;
                margin-top: 28px;
            }

            .explore-login {
                width: 100%;
            }

            .academy {
                padding: 35px 18px;
            }

            .academy-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .academy-layout {
                grid-template-columns: 1fr;
            }

            .academy-modules {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .lesson-panel {
                min-height: 0;
            }
        }

        @@media (max-width: 480px) {
            .explore-topline {
                align-items: flex-start;
                flex-direction: column;
            }

            .explore-close {
                width: 100%;
            }

            .practice-form,
            .practice-result {
                grid-template-columns: 1fr;
            }

            .practice-full {
                grid-column: auto;
            }

            .academy-modules {
                grid-template-columns: 1fr;
            }

            .lesson-actions {
                flex-direction: column;
            }

            .lesson-button {
                width: 100%;
            }
        }

        /* ==========================================
           ACCESIBILIDAD
        ========================================== */

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            .explore-section,
            .explore-card,
            .explore-status-dot,
            .academy.is-open {
                animation: none !important;
            }

            .explore-section {
                opacity: 1;
                transform: none;
            }

            .explore-card {
                opacity: 1;
                transform: none;
                transition: none;
            }

            .explore-details,
            .academy-module,
            .lesson-button,
            .academy-progress-fill {
                transition: none;
            }
        }
    </style>
</head>

<body>
    <div class="space-background">
        <canvas id="starfield"></canvas>
        <div class="nebula nebula-one"></div>
